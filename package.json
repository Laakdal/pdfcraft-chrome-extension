{
  "name": "pdfcraft-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "description": "PdfCraft for Chrome: a standalone MV3 extension that opens PDFs in the bundled PdfCraft web build.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "fetch-pdfcraft": "node scripts/fetch-pdfcraft.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:chrome": "node tests/e2e/chrome-smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.58.2",
    "puppeteer-core": "24.43.1"
  }
}
